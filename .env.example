# ---------------------------------------------------------------------------
# AI Image Generator — server environment variables
#
# Copy this file to `.env.local` for development, or configure the same keys
# in the Vercel project settings for production/preview.
# ---------------------------------------------------------------------------

# Base URL of the Pollinations AI image endpoint.
# Override only if you proxy through your own domain.
POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt

# Request timeout (milliseconds) applied to provider calls.
POLLINATIONS_TIMEOUT_MS=30000
